# Required for the real trainer
ANTHROPIC_API_KEY=sk-ant-...

# LLM
LLM_PROVIDER=anthropic        # anthropic | mock (mock = no key, canned responses, for smoke tests)
MODEL=claude-opus-5-5
TEACH_EFFORT=medium           # low | medium | high
GRADE_EFFORT=low
LLM_FALLBACKS=1               # server-side refusal fallback (Claude API only; auto-disabled if rejected)

# Server
PORT=8000
